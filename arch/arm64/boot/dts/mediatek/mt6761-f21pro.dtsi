// mt6761.dts
&camera_af_hw_node {
	camaf_m1_pmic-supply = <&mt_pmic_vmch_ldo_reg>;
};

&flashlights_mt6370 {
	decouple = <1>;
	/delete-node/ channel@2;
};

&lk_charger {
	/* charging current */
	ac_charger_current = <1500000>;
	ac_charger_input_current = <1600000>;
};
&charger {
	/* common */
	battery_cv = <4400000>;

	/* battery temperature protection */
	max_charge_temp = <55>;

	/* charging current */
	ac_charger_current = <1500000>;
	ac_charger_input_current = <1600000>;
};


