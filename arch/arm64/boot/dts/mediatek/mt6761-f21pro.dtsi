// mt6357.dtsi
&clock_buffer_ctrl {
	/delete-property/ pmic-default-capid;
};


// cust_mt6761_msdc.dtsi
&msdc1 {
	status = "disabled";
};


// mt6370.dtsi
&mt6370_pmu {
	bled {
		mt,chan_en  = <0xC>; /* bit 0 1 2 3 -> chan 1 2 3 4 */

		/* we have 11 bit resolution, quantize in driver */
		mt,max_bled_brightness = <2047>; /* maximum 2047 */

		mt,bled_curr_scale = <1>;	/* 0: 30mA, 1: 22.5mA */
						/* 2: 20mA, 3: 17.5mA */
	};
};
